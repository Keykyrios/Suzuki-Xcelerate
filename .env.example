# Copy to .env and adjust for your machine. The demo runs fully offline once
# model weights and map assets are present locally (data/models, data/synthetic).

# Root of the repository (auto-detected when omitted).
NEXUS7_ROOT=

# HTTP bind settings for the API/WS server.
NEXUS7_HOST=127.0.0.1
NEXUS7_PORT=8000

# Optional operator token for state-changing endpoints on a shared demo network.
# When empty, local operator access is unrestricted (single-machine demo mode).
NEXUS7_OPERATOR_TOKEN=

# Vision source: "camera" (local USB/webcam), "sample" (prerecorded frames in
# data/processed/cabin_eval_set), or "off" (manual cabin control only).
NEXUS7_VISION_SOURCE=off

# Camera index when NEXUS7_VISION_SOURCE=camera.
NEXUS7_CAMERA_INDEX=0

# Directory holding local model weights (no runtime downloads).
NEXUS7_MODEL_DIR=data/models
